---
import '../styles/global.css';
import { u, NAV } from '../lib/site';

interface Props {
  title: string;
  description: string;
  active?: string;
  noindex?: boolean;
}
const { title, description, active, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const SITE = new URL(Astro.site!).origin + '/';
const ogImage = new URL('og-bild.jpg', SITE).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': SITE + '#person',
      name: 'Dr. Alexander Tiffert',
      honorificPrefix: 'Dr.',
      givenName: 'Alexander',
      familyName: 'Tiffert',
      jobTitle: 'Systemischer Berater, Executive Coach und Fotograf',
      description: 'Systemischer Berater und Executive Coach in Lübeck. Begleitet Führungskräfte, Managementteams, Unternehmerfamilien und Beratungsteams in komplexen Entscheidungssituationen; verbindet Beratung mit künstlerischer Fotografie.',
      url: SITE,
      image: ogImage,
      email: 'mailto:kontakt@dr-tiffert.de',
      address: { '@type': 'PostalAddress', addressLocality: 'Lübeck', postalCode: '23552', addressCountry: 'DE' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universität Rostock' },
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'Promotion (Dr.)' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'Diplom-Wirtschaftsingenieur' },
      ],
      knowsAbout: ['Executive Coaching', 'Systemische Beratung', 'Organisationsberatung', 'Nachfolge in Familienunternehmen', 'Supervision', 'Kunstanaloges Coaching', 'Emotionsmanagement', 'Gruppendynamik', 'Führung von Vertriebsorganisationen', 'Customer Experience Management', 'Künstlerische Fotografie'],
      sameAs: ['https://alextiffert.com/'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': SITE + '#praxis',
      name: 'Dr. Alexander Tiffert · Systemische Beratung',
      slogan: 'Komplexität bewältigen. Unsicherheit aushalten. Verantwortlich entscheiden.',
      url: SITE,
      image: ogImage,
      logo: new URL('wortmarke_dunkel.svg', SITE).href,
      email: 'kontakt@dr-tiffert.de',
      founder: { '@id': SITE + '#person' },
      address: { '@type': 'PostalAddress', addressLocality: 'Lübeck', postalCode: '23552', addressCountry: 'DE' },
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      knowsLanguage: 'de',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Leistungen',
        itemListElement: [
          ['Executive Coaching', 'executive-coaching/', 'Begleitung von Führungskräften und Managementteams bei Entscheidungen, die sich nicht delegieren lassen.'],
          ['Nachfolge', 'nachfolge/', 'Nachfolgebegleitung für Familienunternehmen: Familie, Eigentum und Unternehmen auseinanderhalten und Entscheidungswege klären.'],
          ['Supervision', 'supervision/', 'Supervision für interne Beratungsteams und externe Organisationsberatungen.'],
          ['Kunstanaloges Coaching', 'kunstanaloges-coaching/', 'Coaching mit Fotografie: Eigene Bilder machen sichtbar, was sich noch nicht in Worte fassen lässt.'],
        ].map(([name, pfad, beschreibung]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name, description: beschreibung, url: SITE + pfad, provider: { '@id': SITE + '#person' } } })),
      },
    },
    ...[
      ['Customer Experience Management in der Praxis. Grundlagen – Zusammenhänge – Umsetzung', '2019', null],
      ['Coaching von Mitarbeitern im persönlichen Verkauf. Nachhaltige Kompetenzentwicklung für den Face-to-Face-Kontakt mit Kunden', '2021', '2. Auflage'],
      ['Führung von Vertriebsorganisationen. Strategie – Koordination – Umsetzung', '2020', '2. Auflage'],
    ].map(([name, jahr, auflage], i) => ({
      '@type': 'Book',
      '@id': SITE + 'hintergrund/#buch-' + (i + 1),
      name,
      datePublished: jahr,
      ...(auflage ? { bookEdition: auflage } : {}),
      inLanguage: 'de',
      publisher: { '@type': 'Organization', name: 'Springer Gabler' },
      [i === 2 ? 'editor' : 'author']: i === 2
        ? [{ '@type': 'Person', name: 'Lars Binckebanck' }, { '@type': 'Person', name: 'Ann-Kristin Hölter' }, { '@id': SITE + '#person' }]
        : { '@id': SITE + '#person' },
    })),
    {
      '@type': 'WebSite',
      '@id': SITE + '#website',
      url: SITE,
      name: 'Dr. Alexander Tiffert',
      inLanguage: 'de-DE',
      publisher: { '@id': SITE + '#person' },
    },
    {
      '@type': 'WebPage',
      '@id': canonical + '#seite',
      url: canonical,
      name: title === 'Startseite' ? 'Dr. Alexander Tiffert' : title,
      description,
      inLanguage: 'de-DE',
      isPartOf: { '@id': SITE + '#website' },
      about: { '@id': SITE + '#person' },
    },
  ],
};
const fullTitle = title === 'Startseite'
  ? 'Dr. Alexander Tiffert · Komplexität bewältigen. Unsicherheit aushalten. Verantwortlich entscheiden.'
  : `${title} · Dr. Alexander Tiffert`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f3832" />
    <meta name="author" content="Dr. Alexander Tiffert" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Dr. Alexander Tiffert" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dr. Alexander Tiffert an der geöffneten Glastür einer Dachterrasse" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={u('favicon-32.png')} />
    <link rel="apple-touch-icon" href={u('apple-touch-icon-180.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={u()}>
          <img src={u('wortmarke_hell.svg')} width="409" height="52" alt="Dr. Alexander Tiffert" />
          <span class="brand-sub">Systemische Beratung · Künstlerische Fotografie</span>
          <span class="visually-hidden">, zur Startseite</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hauptmenue">
          <span class="menu-toggle-label">Menü</span>
          <span class="bars" aria-hidden="true"></span>
        </button>
        <nav class="main-nav" id="hauptmenue" aria-label="Hauptmenü">
          <ul>
            {NAV.map((item) => (
              <li class={item.cta ? 'nav-cta' : undefined}><a href={u(item.href)} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Dr. Alexander Tiffert · Lübeck</span>
          <span class="footer-legal"><a href={u('impressum/')}>Impressum</a> · <a href={u('datenschutz/')}>Datenschutz</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var header = document.querySelector('.site-header');
        function setH() { if (header) root.style.setProperty('--header-h', header.offsetHeight + 'px'); }
        setH(); window.addEventListener('resize', setH);
        function onScroll() { if (header) header.classList.toggle('is-scrolled', window.scrollY > 8); }
        onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

        var btn = document.querySelector('.menu-toggle');
        var nav = document.getElementById('hauptmenue');
        if (btn && nav) {
          var set = function (open) {
            btn.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
            btn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
            document.body.style.overflow = open ? 'hidden' : '';
            setH();
          };
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
          });
        }

        var items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach(function (el) { el.classList.add('is-in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          items.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
  </body>
</html>
