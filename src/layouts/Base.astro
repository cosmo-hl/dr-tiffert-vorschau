---
import '../styles/global.css';
import { u, NAV, MAIL, PHONE_DISPLAY, PHONE_HREF } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** aktiver Hauptmenüpunkt, z. B. 'supervision/' */
  active?: string;
  /** Abschluss-Band mit Gesprächseinladung anzeigen */
  invite?: boolean;
  preloadImage?: { href: string; srcset?: string; sizes?: string };
}
const { title, description, active, invite = true, preloadImage } = Astro.props;
const fullTitle = title === 'Startseite'
  ? 'Dr. Alexander Tiffert · Komplexität klären. Verantwortlich entscheiden.'
  : `${title} · Dr. Alexander Tiffert`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <div class="preview-bar" role="note">
      <div class="wrap">Entwurf 3.1 · nicht öffentliche Vorschau, nicht zur Veröffentlichung freigegeben</div>
    </div>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={u()} aria-label="Dr. Alexander Tiffert, zur Startseite">Dr. Alexander Tiffert</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hauptmenue">
          <span class="bars" aria-hidden="true"><span></span></span>
          <span class="menu-toggle-label">Menü</span>
        </button>
        <nav class="main-nav" id="hauptmenue" aria-label="Hauptmenü">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={u(item.href)} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    {invite && (
      <section class="invite" aria-labelledby="einladung">
        <div class="wrap invite-grid">
          <div>
            <h2 id="einladung">Über Ihre Situation sprechen</h2>
            <p class="cta-row" style="margin-top:0">
              <a class="btn" href={u('kontakt/')}>Persönliches Gespräch anfragen</a>
            </p>
          </div>
          <ul class="contact-lines" aria-label="Direkte Kontaktwege">
            <li>E-Mail schreiben: <a href={`mailto:${MAIL}`}>{MAIL}</a></li>
            <li>Anrufen: <a href={PHONE_HREF}>{PHONE_DISPLAY}</a></li>
          </ul>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-name">Dr. Alexander Tiffert</p>
          <p>Lübeck</p>
        </div>
        <div>
          <h2>Kontakt</h2>
          <ul>
            <li><a href={u('kontakt/')}>Kontaktseite</a></li>
            <li><a href={`mailto:${MAIL}`}>{MAIL}</a></li>
            <li><a href={PHONE_HREF}>{PHONE_DISPLAY}</a></li>
          </ul>
        </div>
        <div>
          <h2>Rechtliches</h2>
          <ul>
            <li class="pending">Impressum (vor Veröffentlichung freizugeben)</li>
            <li class="pending">Datenschutz (vor Veröffentlichung freizugeben)</li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var nav = document.getElementById('hauptmenue');
        if (!btn || !nav) return;
        var label = btn.querySelector('.menu-toggle-label');
        function set(open) {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
          label.textContent = open ? 'Menü schließen' : 'Menü';
        }
        btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
        });
      })();
    </script>
  </body>
</html>
