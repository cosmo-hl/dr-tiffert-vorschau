---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import Photo from '../../components/Photo.astro';
import Stimme from '../../components/Stimme.astro';
import { u, MAIL } from '../../lib/site';
import { STIMMEN } from '../../lib/stimmen';
---
<Base
  title="Qualifikation"
  active="qualifikation/"
  description="Qualifikation von Dr. Alexander Tiffert: fast 20 Jahre Berufserfahrung, Promotion, Ausbildungen in Coaching, Gruppendynamik, Aufstellungsarbeit und systemischer Organisationsentwicklung, Lehre an Hochschulen und drei Fachbücher."
>
  <SubHero
    eyebrow="Qualifikation"
    title="Was mich qualifiziert"
    lead="Fast 20 Jahre Berufserfahrung, eine fundierte Ausbildung bei den Vordenkern der Branche und zehn Jahre Lehre."
    name="site-lehre" w={3543} h={1949} pos="62% 70%" posM="62% 80%"
    alt="Dr. Alexander Tiffert steht an einem Pult unter einer großen Projektionsfläche." />

  <section class="section" aria-labelledby="h-hintergrund">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Hintergrund</p>
        <h2 id="h-hintergrund">Erfahrung, Ausbildung, Lehre</h2>
      </div>
      <ul class="bg-grid">
        <li class="reveal"><strong>Fast 20</strong><span>Jahre Berufserfahrung mit Topmanagementteams</span></li>
        <li class="reveal reveal-d1"><strong>Dr.</strong><span>Wirtschaftsingenieur, Coach und systemischer Organisationsentwickler</span></li>
        <li class="reveal reveal-d2"><strong>10</strong><span>Jahre Lehre an Hochschulen, drei Fachbücher</span></li>
      </ul>
    </div>
  </section>

  <section class="section paper" aria-labelledby="h-ausbildung">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">02</span> Werdegang</p>
        <h2 id="h-ausbildung">Mein Weg</h2>
      </div>
      <div class="split-body measure reveal">
        <ul class="lines-list">
          <li><strong>Studium</strong>Als Diplom-Wirtschaftsingenieur habe ich gelernt, interdisziplinär zu denken und Fachdisziplinen selbstverständlich miteinander zu verbinden.</li>
          <li><strong>Promotion</strong>In meiner Doktorarbeit an der Universität Rostock habe ich mich mit Emotionsmanagement beschäftigt, also damit, wie man auch unter Druck mit Gefühlen umgeht. Dafür habe ich ein Training entwickelt.</li>
          <li><strong>Ausbildungen</strong>Danach habe ich meine Kompetenz in Coaching, Gruppendynamik und systemischer Beratung weiterentwickelt, bei Vordenkern der Branche wie Prof. Dr. Fritz B. Simon und Prof. Dr. Rudolf Wimmer.</li>
          <li><strong>Lehre und Forschung</strong>Zehn Jahre lang habe ich an verschiedenen Hochschulen Organisationsberatung und Verkauf unterrichtet und Studierende sowie Forschungsprojekte begleitet.</li>
        </ul>
        <p>Dazu kommt meine Lebenserfahrung. Ich habe selbst erfahren, wie schnell sich Dinge verändern können.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-lehre">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">03</span> Lehre</p>
        <h2 id="h-lehre">Methoden und Konzepte der Organisationsberatung</h2>
      </div>
      <div class="split-body measure reveal">
        <p class="lead">An der Hochschule Fresenius in Hamburg habe ich fast zehn Jahre lang das Fach „Methoden und Konzepte der Organisationsberatung“ unterrichtet, immer ausgehend von konkreten Fällen.</p>
        <ul class="places" aria-label="Frühere Lehraufträge">
          <li>Hochschule Fresenius<span>Hamburg</span></li>
          <li>FOM<span>Hamburg</span></li>
          <li>NORDAKADEMIE<span>Elmshorn</span></li>
          <li>Universität Rostock<span>Weiterbildungsprogramm</span></li>
        </ul>
        <p>Für das Frühjahr 2027 ist an der Kunstschule Lübeck der Kurs „Künstlerische Fotografie – den eigenen Blick entwickeln“ geplant.</p>
      </div>
    </div>
  </section>

  <section class="section paper" aria-labelledby="h-fach">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">04</span> Springer Gabler</p>
        <h2 id="h-fach">Fachbücher</h2>
      </div>
      <ul class="books">
        <li class="reveal">
          <div class="cover"><Photo name="buch-cx" w={563} h={768} alt="Buchcover: Customer Experience Management in der Praxis" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Customer Experience Management in der Praxis.</i> Grundlagen – Zusammenhänge – Umsetzung.</h3>
          <p class="meta">Alexander Tiffert, Springer Gabler, 2019.</p>
        </li>
        <li class="reveal reveal-d1">
          <div class="cover"><Photo name="buch-coaching" w={563} h={768} alt="Buchcover: Coaching von Mitarbeitern im persönlichen Verkauf, 2. Auflage" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Coaching von Mitarbeitern im persönlichen Verkauf.</i> Nachhaltige Kompetenzentwicklung für den Face-to-Face-Kontakt mit Kunden.</h3>
          <p class="meta">Alexander Tiffert, 2. Auflage, Springer Gabler, 2021.</p>
        </li>
        <li class="reveal reveal-d2">
          <div class="cover"><Photo name="buch-vertrieb" w={563} h={768} alt="Buchcover: Führung von Vertriebsorganisationen, 2. Auflage" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Führung von Vertriebsorganisationen.</i> Strategie – Koordination – Umsetzung.</h3>
          <p class="meta">Herausgegeben von Lars Binckebanck, Ann-Kristin Hölter und Alexander Tiffert, 2. Auflage, Springer Gabler, 2020.</p>
        </li>
      </ul>
      <p class="papers-line">Außerdem habe ich fotografische Whitepaper geschrieben, etwa zur strukturierten Analyse von Fotografien. <a href={`mailto:${MAIL}?subject=${encodeURIComponent('Interesse an den fotografischen Whitepapern')}`}>Bei Interesse schreiben Sie mir.</a></p>
      <div class="cta-row"><a class="btn" href={u('kontakt/')}>Persönliches Gespräch anfragen <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <Stimme {...STIMMEN.richter} />
</Base>

<style>
  .bg-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  .bg-grid li { border-top: 1px solid var(--navy); padding-top: var(--s2); }
  .bg-grid strong { display: block; font-family: var(--display); font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); font-weight: 500; line-height: 1; color: var(--gold-ink); margin-bottom: 0.6rem; }
  .bg-grid span { color: var(--ink-2); }
  @media (min-width: 900px) { .bg-grid { grid-template-columns: repeat(3, 1fr); gap: var(--s4); } }

  .lines-list { list-style: none; margin: 0 0 var(--s3); padding: 0; border-top: 1px solid var(--rule); }
  .lines-list li { padding: 1rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .lines-list strong { display: block; font-family: var(--display); font-size: 1.5rem; font-weight: 600; line-height: 1.2; color: var(--navy); margin-bottom: 0.2rem; }

  .places { list-style: none; margin: var(--s3) 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  @media (max-width: 560px) { .places { grid-template-columns: minmax(0, 1fr); } }
  .places li { background: var(--white); padding: 1.1rem 1.25rem; font-family: var(--display); font-size: 1.45rem; font-weight: 600; line-height: 1.15; color: var(--navy); }
  .places span { display: block; font-family: var(--sans); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-ink); margin-top: 0.35rem; }

  .books { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  @media (min-width: 900px) { .books { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cover { background: linear-gradient(160deg, #e9ece9, #d6ddd8); aspect-ratio: 1 / 1; display: grid; place-items: center; padding: 9% 0; margin-bottom: var(--s3); overflow: hidden; }
  .cover :global(picture) { display: contents; }
  .cover :global(img) { min-height: 0; height: 100%; width: auto; max-width: 100%; object-fit: contain; box-shadow: 0 18px 30px -16px rgba(21, 38, 31, 0.55); }
  .books h3 { font-family: var(--display); font-size: clamp(1.3rem, 1.15rem + 0.45vw, 1.55rem); font-weight: 500; line-height: 1.2; }
  .books h3 i { font-weight: 600; }
  .meta { color: var(--ink-2); font-size: 0.95rem; }
  .papers-line { margin: var(--s4) 0 0; color: var(--ink-2); max-width: var(--measure); }
</style>
