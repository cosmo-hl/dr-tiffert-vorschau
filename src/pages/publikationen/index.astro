---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { u, MAIL } from '../../lib/site';
---
<Base
  title="Publikationen"
  active="publikationen/"
  description="Publikationen von Dr. Alexander Tiffert: Fachbücher bei Springer Gabler, Fotobücher und fotografische Whitepaper."
>
  <header class="page-hero dark">
    <div class="wrap">
      <p class="eyebrow">Publikationen</p>
      <h1>Fachbücher, Fotobücher und fotografische Whitepaper</h1>
    </div>
  </header>

  <section class="section" aria-labelledby="h-fach">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Springer Gabler</p>
        <h2 id="h-fach">Fachbücher</h2>
      </div>
      <ul class="books">
        <li class="reveal">
          <div class="cover"><Photo name="buch-cx" w={563} h={768} alt="Buchcover: Customer Experience Management in der Praxis" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Customer Experience Management in der Praxis.</i> Grundlagen – Zusammenhänge – Umsetzung.</h3>
          <p class="meta">Alexander Tiffert, Springer Gabler, 2019.</p>
          <p>Eine Einführung mit Fallbeispielen zur Gestaltung von Kundenerlebnissen über einzelne Kontaktpunkte hinweg.</p>
          <p class="pending-link">Zum Buch (Verlagslink wird vor Veröffentlichung ergänzt)</p>
        </li>
        <li class="reveal reveal-d1">
          <div class="cover"><Photo name="buch-coaching" w={563} h={768} alt="Buchcover: Coaching von Mitarbeitern im persönlichen Verkauf, 2. Auflage" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Coaching von Mitarbeitern im persönlichen Verkauf.</i> Nachhaltige Kompetenzentwicklung für den Face-to-Face-Kontakt mit Kunden.</h3>
          <p class="meta">Alexander Tiffert, 2. Auflage, Springer Gabler, 2021.</p>
          <p>Ein Buch für Führungskräfte, die Mitarbeitende im Verkauf durch Coaching in ihrer Entwicklung unterstützen möchten.</p>
          <p class="pending-link">Zum Buch (Verlagslink wird vor Veröffentlichung ergänzt)</p>
        </li>
        <li class="reveal reveal-d2">
          <div class="cover"><Photo name="buch-vertrieb" w={563} h={768} alt="Buchcover: Führung von Vertriebsorganisationen, 2. Auflage" sizes="(min-width: 900px) 360px, 80vw" /></div>
          <h3><i>Führung von Vertriebsorganisationen.</i> Strategie – Koordination – Umsetzung.</h3>
          <p class="meta">Herausgegeben von Lars Binckebanck, Ann-Kristin Hölter und Alexander Tiffert, 2. Auflage, Springer Gabler, 2020.</p>
          <p>Beiträge aus Forschung, Beratung und Unternehmenspraxis.</p>
          <p class="pending-link">Zum Buch (Verlagslink wird vor Veröffentlichung ergänzt)</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section paper" aria-labelledby="h-foto">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">02</span> Fotografie</p>
        <h2 id="h-foto">Fotobücher</h2>
      </div>
      <div class="split-body measure reveal">
        <p class="lead">Zu meinen bisherigen Fotobüchern gehören <i>Urban Silence</i> und <i>lettera d’amore</i>.</p>
        <p class="pending-link">Zur Übersicht meiner Fotobücher (Link wird vor Veröffentlichung ergänzt)</p>
        <p>Mehr zum aktuellen Fotobuchprojekt <i>Spuren der Suche</i> auf der Seite <a href={u('fotografie/')}>Künstlerische Fotografie</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-wp">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">03</span> Texte</p>
        <h2 id="h-wp">Fotografische Whitepaper</h2>
      </div>
      <ol class="papers">
        <li class="reveal">
          <h3><i>Wahrnehmungsmodi in der Fotografie.</i> Ein Prozessmodell des künstlerischen Fotografierens.</h3>
          <p>Wie wechseln Aufmerksamkeit, Wahrnehmung und Handeln beim Fotografieren?</p>
        </li>
        <li class="reveal reveal-d1">
          <h3><i>Personen im Bild.</i></h3>
          <p>Wie verändert die Anwesenheit einer Person im Bild die Wahrnehmung des Raums und das Verhältnis zu den Betrachtenden?</p>
        </li>
        <li class="reveal reveal-d2">
          <h3><i>Strukturierte Analyse von Fotografien.</i></h3>
          <p>Wie lässt sich die Wirkung eines Bildes präzise beschreiben? Der Text bietet Kriterien für die Reflexion und Auswahl von Bildern.</p>
        </li>
      </ol>
      <div class="cta-row">
        <a class="btn" href={`mailto:${MAIL}?subject=${encodeURIComponent('Interesse an den fotografischen Whitepapern')}`}>Bei Interesse an den Whitepapern schreiben <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .books { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  @media (min-width: 900px) { .books { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cover { background: linear-gradient(160deg, #e9ece9, #d6ddd8); aspect-ratio: 1 / 1; display: grid; place-items: center; padding: 9% 0; margin-bottom: var(--s3); overflow: hidden; }
  .cover :global(picture) { display: contents; }
  .cover :global(img) { min-height: 0; height: 100%; width: auto; max-width: 100%; object-fit: contain; box-shadow: 0 18px 30px -16px rgba(21, 38, 31, 0.55); transition: transform 0.5s var(--ease); }
  .books li:hover .cover :global(img) { transform: translateY(-6px) rotate(-1deg); }
  .books h3 { font-family: var(--display); font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.65rem); font-weight: 500; line-height: 1.2; }
  .books h3 i { font-weight: 600; }
  .meta { color: var(--ink-2); font-size: 0.95rem; }
  .pending-link { color: var(--ink-2); font-size: 0.9rem; font-style: italic; }

  .papers { list-style: none; counter-reset: p; margin: 0; padding: 0; display: grid; gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .papers li { counter-increment: p; background: var(--white); padding: clamp(1.5rem, 3vw, 2.25rem); }
  .papers li::before { content: '0' counter(p); display: block; font-family: var(--display); font-size: 2.6rem; line-height: 1; color: var(--gold-ink); margin-bottom: var(--s2); }
  .papers h3 { font-family: var(--display); font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.65rem); font-weight: 500; line-height: 1.2; }
  .papers h3 i { font-weight: 600; }
  .papers p { margin: 0; color: var(--ink-2); }
  @media (min-width: 900px) { .papers { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
