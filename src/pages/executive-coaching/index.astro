---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import Stimme from '../../components/Stimme.astro';
import { u } from '../../lib/site';
import { STIMMEN } from '../../lib/stimmen';
---
<Base
  title="Executive Coaching"
  active="executive-coaching/"
  description="Executive Coaching mit Dr. Alexander Tiffert: Begleitung von Führungskräften und Managementteams bei Entscheidungen, die sich nicht delegieren lassen."
>
  <SubHero
    eyebrow="Executive Coaching"
    title="Entscheidungen, die Sie nicht delegieren können"
    lead="Ich begleite Führungskräfte und Managementteams, wenn keine Option einfach ist."
    name="site-fenster" w={3543} h={2372} pos="80% 50%" posM="78% 50%"
    alt="Dr. Alexander Tiffert sitzt in einem Sessel an einer großen Fensterfront und blickt über die Stadt." />

  <section class="section" aria-labelledby="h-ec">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">01</span> Angebot</p>
        <h2 id="h-ec">Einzeln oder im Managementteam</h2>
      </div>
      <div class="split-body measure reveal">
        <p class="lead">Wenn der Markt schwer einzuschätzen ist und mehrere Entwicklungen zugleich Druck machen, begleite ich Sie dabei, handlungsfähig zu bleiben und Ihrem Team Orientierung zu geben.</p>
        <p>Wir arbeiten an einer konkreten Situation: Welche Erwartungen werden an Sie herangetragen, nach welchen Maßstäben urteilen Sie, welche Folgen können Sie tragen?</p>
        <p>Ich bin ein vertrauliches Gegenüber, das auch Unbequemes anspricht. Einzeln oder im Managementteam. Die Entscheidung bleibt bei Ihnen.</p>
      </div>
    </div>
  </section>

  <Stimme {...STIMMEN.simonis} />
</Base>
