---
import Base from '../../layouts/Base.astro';
import SubHero from '../../components/SubHero.astro';
import Stimme from '../../components/Stimme.astro';
import { u } from '../../lib/site';
import { STIMMEN } from '../../lib/stimmen';
---
<Base
  title="Profil"
  active="profil/"
  description="Profil von Dr. Alexander Tiffert, Lübeck: Diplom-Wirtschaftsingenieur, Promotion an der Universität Rostock, fast 20 Jahre Beratung, Hochschullehre, Fachbücher und künstlerische Fotografie."
>
  <SubHero
    eyebrow="Profil"
    title="Dr. Alexander Tiffert"
    lead="Unabhängiger Reflexions- und Entscheidungspartner für Menschen in Verantwortung."
    name="site-profil" w={3543} h={2372} pos="85% 55%" posM="80% 55%"
    alt="Dr. Alexander Tiffert sitzt mit einer Kaffeetasse auf einem Sofa in einem hellen Besprechungsraum." />

  <section class="section" aria-labelledby="h-weg">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">01</span> Werdegang</p>
        <h2 id="h-weg">Hintergrund</h2>
      </div>
      <div class="split-body measure reveal">
        <ul class="facts">
          <li><span>Beratung</span>Fast 20 Jahre, zuerst in einer internationalen Vertriebsberatung, dann im eigenen Unternehmen</li>
          <li><span>Studium</span>Diplom-Wirtschaftsingenieur mit den Schwerpunkten Vertriebsführung und Verkaufspsychologie</li>
          <li><span>Promotion</span>Universität Rostock</li>
          <li><span>Ausbildungen</span>Mehrjährige Ausbildungen in Gruppendynamik, Familien- und Organisationsaufstellung, Coaching und systemischer Organisationsentwicklung</li>
          <li><span>Lehre</span>Fast zehn Jahre an Hochschulen</li>
          <li><span>Publikationen</span>Drei Fachbücher und mehrere Fotobücher</li>
          <li><span>Lebenserfahrung</span>Ich weiß aus eigener Erfahrung, wie schnell sich Dinge verändern können.</li>
        </ul>
        <p class="further">
          <a class="more" href={u('fotografie/')}>Zur Fotografie <span class="arrow" aria-hidden="true">→</span></a>
          <a class="more" href={u('lehre/')}>Zur Lehre <span class="arrow" aria-hidden="true">→</span></a>
          <a class="more" href={u('publikationen/')}>Zu den Publikationen <span class="arrow" aria-hidden="true">→</span></a>
        </p>
        <div class="cta-row"><a class="btn" href={u('kontakt/')}>Erstgespräch anfragen <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <Stimme {...STIMMEN.richter} />
</Base>

<style>
  .facts { list-style: none; margin: var(--s3) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .facts li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.2rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
  .facts span { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-ink); }
  @media (min-width: 640px) { .facts li { grid-template-columns: 9.5rem minmax(0, 1fr); gap: 1.25rem; align-items: baseline; } }
  .further { display: flex; flex-wrap: wrap; gap: 0 2rem; margin-top: var(--s3); }
</style>
