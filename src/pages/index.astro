---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Stimme from '../components/Stimme.astro';
import { u, MAIL } from '../lib/site';
import { STIMMEN } from '../lib/stimmen';

---
<Base
  title="Startseite"
  description="Dr. Alexander Tiffert begleitet Führungskräfte, Managementteams, Unternehmerfamilien und Beratungsteams, wenn keine Option einfach ist: Executive Coaching, Nachfolge und Supervision."
>
  <!-- HERO: freigegebener Einstieg, wortgetreu -->
  <section class="hero dark" aria-labelledby="claim">
    <div class="hero-media" aria-hidden="true">
      <Photo name="site-terrasse" w={3543} h={1730} alt="" sizes="100vw" position="70% 30%" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="claim"><span>Komplexität bewältigen.</span> <span>Unsicherheit aushalten.</span> <span>Verantwortlich entscheiden.</span></h1>
      <p class="lead">Ich begleite Menschen und Teams in komplexen Situationen. Auch wenn die Richtung noch unklar ist, helfe ich, die Unsicherheit auszuhalten und entscheidungsfähig zu bleiben.</p>
      <figure class="hero-photo-mobile">
        <Photo name="site-terrasse-mobil" w={2306} h={1730} alt="Dr. Alexander Tiffert steht an einer geöffneten Glastür einer Dachterrasse und blickt über die Stadt." sizes="100vw" eager />
      </figure>
    </div>
  </section>

  <!-- EINSTIEG: freigegebener Absatz, in drei Absätze gegliedert (Wortlaut unverändert); rechts das Kontaktangebot -->
  <section class="section intro" aria-labelledby="h-einstieg">
    <div class="wrap intro-grid">
      <div class="intro-main reveal">
        <h2 id="h-einstieg" class="visually-hidden">Mein Mehrwert</h2>
        <p class="statement">Darin liegt meine Kraft: mit Ihnen auszuhalten, was noch offen ist, und trotzdem handlungs- und entscheidungsfähig zu bleiben.</p>
        <p class="statement-sub">Wie sich Unsicherheit und Nichtwissen anfühlen, weiß ich aus eigener Erfahrung.</p>
      </div>
      <aside class="intro-contact reveal reveal-d1" aria-labelledby="h-kontaktangebot">
        <h3 id="h-kontaktangebot">Vor welcher Entscheidung stehen Sie gerade?</h3>
        <p>Wenn Sie sich ein unabhängiges Gegenüber wünschen, lade ich Sie zu einem persönlichen Gespräch ein.</p>
        <ul class="contact-lines" aria-label="Direkte Kontaktwege">
          <li><span>E-Mail</span><a href={`mailto:${MAIL}`}>{MAIL}</a></li>
        </ul>
        <p class="signature">Ihr Dr. Alexander Tiffert</p>
      </aside>
    </div>
  </section>

  <!-- DREI FELDER -->
  <section class="section paper" id="felder" aria-labelledby="h-felder">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Themenfelder</p>
        <h2 id="h-felder">Wobei ich begleite</h2>
      </div>
      <ol class="occasions">
        <li class="reveal">
          <a href={u('executive-coaching/')}>
            <span class="roman" aria-hidden="true">I</span>
            <h3>Executive Coaching</h3>
            <p>Für Führungskräfte und Managementteams, die Entscheidungen treffen müssen, die sich nicht delegieren lassen.</p>
            <span class="more">Zum Executive Coaching <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d1">
          <a href={u('nachfolge/')}>
            <span class="roman" aria-hidden="true">II</span>
            <h3>Nachfolge</h3>
            <p>Für Familienunternehmen, wenn Familie, Eigentum und Unternehmen gleichzeitig in Bewegung sind.</p>
            <span class="more">Zur Nachfolgebegleitung <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d2">
          <a href={u('supervision/')}>
            <span class="roman" aria-hidden="true">III</span>
            <h3>Supervision</h3>
            <p>Für interne und externe Beratungsteams, deren Mandate ins Stocken geraten.</p>
            <span class="more">Zur Supervision <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- HALTUNG -->
  <section class="section" aria-labelledby="h-haltung">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">02</span> Haltung</p>
        <h2 id="h-haltung">Ungewöhnlich und ungewöhnlich wirksam: die Verbindung von Fotografie und Beratung</h2>
      </div>
      <div class="split-body measure reveal">
        <p class="lead">Ob in der Beratung, im Coaching oder in der Fotografie: Ich verstehe Wirklichkeit als Konstruktion. Dieselbe Situation sieht je nach Blickwinkel anders aus. Fotografie ist für mich Sehen lernen, und das wirkt auch ohne Kamera. Wer das erfährt, sieht beweglicher, nimmt genauer wahr und findet neue Möglichkeiten.</p>
      </div>
    </div>
  </section>

  <!-- FOTOGRAFIE IM COACHING -->
  <section class="section art dark" aria-labelledby="h-foto">
    <div class="wrap art-grid">
      <figure class="art-img reveal">
        <Photo name="7Y5A0358" w={5359} h={3573} alt="Straßenfotografie von Alexander Tiffert." sizes="(min-width: 1024px) 58vw, 100vw" />
      </figure>
      <div class="art-text reveal reveal-d1">
        <p class="eyebrow">Besondere Methode · Kunstanaloges Coaching</p>
        <h2 id="h-foto">Bilder als Spiegel</h2>
        <p>Fotografie schult die Wahrnehmung und macht den eigenen Blick beweglicher. Im kunstanalogen Coaching finden wir so Lösungen auch jenseits rationaler Erklärungen.</p>
        <a class="more" href={u('kunstanaloges-coaching/')}>Zum kunstanalogen Coaching <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Stimme {...STIMMEN.meyer} />

</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-media { display: none; }
  .hero-inner { position: relative; padding-block: var(--s4) var(--s4); }
  .hero h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.6rem); margin-bottom: var(--s3); }
  .hero h1 span { display: block; }
  .hero .lead { color: #fff; max-width: 36ch; margin-bottom: var(--s3); }
  .hero-cta { margin-bottom: var(--s3); }
  .hero-photo-mobile { margin: 0 calc(-1 * var(--gutter)) var(--s3); }
  .hero-photo-mobile :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 420px) { .hero-cta .btn { width: 100%; } }

  @media (min-width: 1024px) {
    .hero-media { display: block; position: absolute; inset: 0; }
    .hero-media :global(picture) { display: block; height: 100%; }
    .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .hero-media::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(21, 38, 31, 0.97) 0%, rgba(31, 56, 50, 0.92) 36%, rgba(31, 56, 50, 0.55) 54%, rgba(31, 56, 50, 0) 70%);
    }
    .hero-photo-mobile { display: none; }
    .hero-inner { display: flex; flex-direction: column; align-items: flex-start; padding-block: clamp(3.5rem, 6vw, 5rem); min-height: min(68vh, 620px); justify-content: center; }
    .hero h1, .hero .lead { max-width: 640px; }
    .hero h1 { max-width: none; font-size: clamp(2.4rem, 1.2rem + 2.9vw, 3.7rem); }
    .hero h1 span { white-space: nowrap; }
    .hero .lead { max-width: 520px; }
    .hero-cta { order: 2; margin: var(--s1) 0 0; }
  }

  /* Einstieg */
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s4); }
  .intro-main { font-size: clamp(1.15rem, 1.05rem + 0.45vw, 1.35rem); line-height: 1.6; color: var(--ink); }
  .intro-main p { margin: 0 0 1.1em; }
  .intro-main .intro-question { margin: 1.4em 0 0; font-family: var(--display); font-size: clamp(1.6rem, 1.3rem + 1.1vw, 2.2rem); line-height: 1.22; color: var(--navy); }
  .intro-contact { background: var(--paper); border-top: 2px solid var(--gold-ink); padding: clamp(1.5rem, 2.6vw, 2.25rem); }
  .intro-contact h3 { font-family: var(--display); font-size: clamp(1.6rem, 1.35rem + 0.8vw, 2rem); font-weight: 500; line-height: 1.12; color: var(--navy); margin-bottom: 0.75rem; }
  .intro-contact p { color: var(--ink-2); }
  .contact-lines { list-style: none; margin: var(--s2) 0; padding: 0; }
  .contact-lines li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.9rem; }
  .contact-lines span { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-ink); min-width: 4.6rem; }
  .contact-lines a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.08rem; color: var(--navy); text-decoration: none; border-bottom: 1px solid var(--gold); white-space: nowrap; }
  .contact-lines a:hover { border-bottom-color: var(--navy); }
  .intro-contact .signature { font-family: var(--display); font-style: italic; font-size: 1.35rem; color: var(--gold-ink); margin: 0; }
  @media (min-width: 1024px) {
    .intro-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  }

  /* Anlässe */
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .occasions a { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 2.6vw, 2.25rem); background: var(--white); text-decoration: none; color: var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease); }
  .occasions .roman { font-family: var(--display); font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3.2rem); line-height: 1; color: var(--gold-ink); margin-bottom: var(--s2); transition: color 0.35s; }
  .occasions h3 { font-family: var(--display); font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.95rem); font-weight: 600; line-height: 1.12; }
  .occasions p { flex: 1; color: var(--ink-2); transition: color 0.35s; }
  .occasions a:hover, .occasions a:focus-visible { background: var(--navy); color: var(--white); }
  .occasions a:hover h3, .occasions a:focus-visible h3 { color: var(--white); }
  .occasions a:hover .roman, .occasions a:focus-visible .roman, .occasions a:hover .more, .occasions a:focus-visible .more { color: var(--gold); }
  .occasions a:hover p, .occasions a:focus-visible p { color: #d6ded9; }
  .occasions a:hover .more .arrow { transform: translateX(5px); }
  @media (min-width: 900px) { .occasions { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .statement-sub { margin: var(--s3) 0 0; color: var(--ink-2); font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); max-width: 40ch; }
  /* Mehrwert */
  .statement { font-family: var(--display); font-size: clamp(1.9rem, 1.3rem + 1.9vw, 2.9rem); line-height: 1.2; color: var(--navy); margin: 0; max-width: 22ch; }
  /* Fotografie */
  .art-grid { display: grid; gap: var(--s4); align-items: center; }
  .art-img { margin: 0; }
  .art-img :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .art-text p:not(.eyebrow) { color: #d6ded9; max-width: 48ch; }
  .art-text .small { font-size: 0.95rem; color: var(--gold); }
  .art-text .more { color: #fff; }
  @media (min-width: 1024px) { .art-grid { grid-template-columns: 7fr 5fr; gap: clamp(3rem, 5vw, 5rem); } }
</style>
