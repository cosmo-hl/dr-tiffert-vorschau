---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Stimme from '../components/Stimme.astro';
import { u, MAIL } from '../lib/site';
import { STIMMEN } from '../lib/stimmen';

---
<Base
  title="Startseite"
  description="Dr. Alexander Tiffert, Lübeck: Entscheidungsbegleitung für Unternehmer, Geschäftsführer und Führungskräfte, Nachfolgebegleitung für Familienunternehmen und Supervision für Beratungsteams."
>
  <!-- HERO: freigegebener Einstieg, wortgetreu -->
  <section class="hero dark" aria-labelledby="claim">
    <div class="hero-media" aria-hidden="true">
      <Photo name="site-terrasse" w={3543} h={1730} alt="" sizes="100vw" position="70% 30%" />
    </div>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-kicker">Entscheidungsbegleitung für Menschen in Verantwortung</p>
      <h1 id="claim">Komplexität klären. <span>Verantwortlich entscheiden.</span></h1>
      <p class="lead">Ich begleite Unternehmer, Geschäftsführer und Führungskräfte, wenn eine Entscheidung nicht delegiert werden kann, Interessen sich widersprechen und Gewissheit nicht erreichbar ist.</p>
      <div class="hero-cta">
        <a class="btn btn--gold" href={u('kontakt/')}>Vertrauliches Erstgespräch anfragen <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-photo-mobile">
        <Photo name="site-terrasse-mobil" w={2306} h={1730} alt="Dr. Alexander Tiffert steht an einer geöffneten Glastür einer Dachterrasse und blickt über die Stadt." sizes="100vw" eager />
      </figure>
      <p class="hero-p1">Als unabhängiges Gegenüber verbinde ich fast 20 Jahre Erfahrung in Organisationsentwicklung und Führung mit einem genauen Blick auf Rollen, Beziehungen und verdeckte Dynamiken.</p>
    </div>
  </section>

  <!-- ANLÄSSE: drei Angebote -->
  <section class="section paper" id="anlaesse" aria-labelledby="h-anlaesse">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Anlässe</p>
        <h2 id="h-anlaesse">Wann ein Gespräch sinnvoll ist</h2>
      </div>
      <ol class="occasions">
        <li class="reveal">
          <a href={u('entscheidungsbegleitung/')}>
            <span class="roman" aria-hidden="true">I</span>
            <h3>Eine Entscheidung lässt sich nicht delegieren.</h3>
            <p>Interessen widersprechen sich, Informationen bleiben unvollständig, und die Folgen reichen über die eigene Rolle hinaus.</p>
            <span class="more">Zur Entscheidungsbegleitung <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d1">
          <a href={u('nachfolge/')}>
            <span class="roman" aria-hidden="true">II</span>
            <h3>Eine Nachfolge verändert mehrere Systeme zugleich.</h3>
            <p>Familie, Eigentum und Unternehmen brauchen unterschiedliche Gespräche und klare Entscheidungsrechte.</p>
            <span class="more">Zur Nachfolgebegleitung <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d2">
          <a href={u('supervision/')}>
            <span class="roman" aria-hidden="true">III</span>
            <h3>Ein Beratungsmandat ist festgefahren.</h3>
            <p>Ungeklärte Dynamiken beim Kunden zeigen sich möglicherweise auch im Beratungsteam.</p>
            <span class="more">Zur Supervision <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ARBEITSWEISE -->
  <section class="section" aria-labelledby="h-arbeitsweise">
    <div class="wrap split">
      <div class="split-head reveal">
        <p class="eyebrow"><span class="num">02</span> Arbeitsweise</p>
        <h2 id="h-arbeitsweise">Wie wir arbeiten</h2>
      </div>
      <div class="split-body measure reveal">
        <p class="lead">Wir arbeiten an einer konkreten Situation. Wir unterscheiden Beobachtungen von Deutungen, prüfen Annahmen und machen sichtbar, welche Rollen, Interessen und Erwartungen auf Ihre Entscheidung wirken.</p>
        <p>Daraus entwickeln Sie Kriterien, mit denen Sie die Folgen abwägen und den nächsten Schritt bewusst vertreten können. Ich bringe Erfahrung, Hypothesen und Widerspruch ein. Die Verantwortung für die Entscheidung bleibt bei Ihnen.</p>
        <ul class="proof" aria-label="Erfahrung">
          <li><strong>fast 20</strong> Jahre Beratung in Organisations- und Führungsfragen</li>
          <li><strong>fast 10</strong> Jahre Lehre an Hochschulen</li>
          <li><strong>3</strong> Fachbücher zu Führung, Coaching und Kundenorientierung</li>
        </ul>
        <a class="more" href={u('profil/')}>Zum Profil <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Stimme {...STIMMEN.meyer} />

  <!-- FOTOGRAFIE: eigenständig -->
  <section class="section art dark" aria-labelledby="h-foto">
    <div class="wrap art-grid">
      <figure class="art-img reveal">
        <Photo name="7Y5A0358" w={5359} h={3573} alt="Straßenfotografie von Alexander Tiffert." sizes="(min-width: 1024px) 58vw, 100vw" />
      </figure>
      <div class="art-text reveal reveal-d1">
        <p class="eyebrow">Künstlerische Fotografie</p>
        <h2 id="h-foto">Eine eigene Praxis</h2>
        <p>In meiner Fotografie beschäftige ich mich mit Situationen, in denen eine vertraute Ordnung mehrdeutig wird. Mit meiner Beratung verbindet sie eine Haltung: genau hinsehen, vorschnelle Erklärungen vermeiden und Widersprüche aushalten.</p>
        <a class="more" href={u('fotografie/')}>Zur Fotografie <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ABSCHLUSS -->
  <section class="section finale" aria-labelledby="h-abschluss">
    <div class="wrap finale-inner reveal">
      <h2 id="h-abschluss">Vor welcher Entscheidung stehen Sie gerade?</h2>
      <p>Wenn Sie sich ein unabhängiges Gegenüber wünschen, klären wir in einem ersten vertraulichen Gespräch, worum es geht und ob eine Zusammenarbeit sinnvoll ist.</p>
      <div class="cta-row">
        <a class="btn" href={u('kontakt/')}>Erstgespräch anfragen <span class="arrow" aria-hidden="true">→</span></a>
        <a class="mail" href={`mailto:${MAIL}`}>{MAIL}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-media { display: none; }
  .hero-inner { position: relative; padding-block: var(--s4) var(--s4); }
  .hero h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.6rem); margin-bottom: var(--s3); }
  .hero h1 span { display: block; }
  .hero .lead { color: #fff; max-width: 36ch; margin-bottom: var(--s3); }
  .hero-cta { margin-bottom: var(--s3); }
  .hero-p1 { color: #d6ded9; max-width: 58ch; margin: 0; }
  .hero-photo-mobile { margin: 0 calc(-1 * var(--gutter)) var(--s3); }
  .hero-photo-mobile :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 420px) { .hero-cta .btn { width: 100%; } }

  @media (min-width: 1024px) {
    .hero-media { display: block; position: absolute; inset: 0; }
    .hero-media :global(picture) { display: block; height: 100%; }
    .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .hero-media::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(21, 38, 31, 0.97) 0%, rgba(31, 56, 50, 0.92) 36%, rgba(31, 56, 50, 0.55) 54%, rgba(31, 56, 50, 0) 70%);
    }
    .hero-photo-mobile { display: none; }
    .hero-inner { display: flex; flex-direction: column; align-items: flex-start; padding-block: clamp(3.5rem, 6vw, 5rem); min-height: min(68vh, 620px); justify-content: center; }
    .hero h1, .hero .lead, .hero-p1 { max-width: 640px; }
    .hero .lead { max-width: 520px; }
    .hero-p1 { order: 1; margin-bottom: var(--s3); }
    .hero-cta { order: 2; margin: var(--s1) 0 0; }
  }

  /* Anlässe */
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .occasions a { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 2.6vw, 2.25rem); background: var(--white); text-decoration: none; color: var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease); }
  .occasions .roman { font-family: var(--display); font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3.2rem); line-height: 1; color: var(--gold-ink); margin-bottom: var(--s2); transition: color 0.35s; }
  .occasions h3 { font-family: var(--display); font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.95rem); font-weight: 600; line-height: 1.12; }
  .occasions p { flex: 1; color: var(--ink-2); transition: color 0.35s; }
  .occasions a:hover, .occasions a:focus-visible { background: var(--navy); color: var(--white); }
  .occasions a:hover h3, .occasions a:focus-visible h3 { color: var(--white); }
  .occasions a:hover .roman, .occasions a:focus-visible .roman, .occasions a:hover .more, .occasions a:focus-visible .more { color: var(--gold); }
  .occasions a:hover p, .occasions a:focus-visible p { color: #d6ded9; }
  .occasions a:hover .more .arrow { transform: translateX(5px); }
  @media (min-width: 900px) { .occasions { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .hero-kicker { color: var(--gold); margin-bottom: var(--s2); }

  /* Belege */
  .proof { list-style: none; margin: var(--s4) 0 var(--s3); padding: 0; display: grid; gap: 0; border-top: 1px solid var(--rule); }
  .proof li { padding: 0.9rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .proof strong { display: inline-block; min-width: 5.5rem; font-family: var(--display); font-size: 1.6rem; font-weight: 600; color: var(--navy); margin-right: 0.5rem; }

  /* Fotografie */
  .art-grid { display: grid; gap: var(--s4); align-items: center; }
  .art-img { margin: 0; }
  .art-img :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .art-text p:not(.eyebrow) { color: #d6ded9; max-width: 46ch; }
  .art-text .more { color: #fff; }
  @media (min-width: 1024px) { .art-grid { grid-template-columns: 7fr 5fr; gap: clamp(3rem, 5vw, 5rem); } }

  /* Abschluss */
  .finale { background: var(--paper); }
  .finale-inner { max-width: 760px; text-align: center; }
  .finale h2 { font-size: clamp(2rem, 1.3rem + 2.2vw, 3rem); }
  .finale p { color: var(--ink-2); }
  .finale .cta-row { justify-content: center; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: var(--s3); }
  .finale .mail { color: var(--navy); }
</style>
