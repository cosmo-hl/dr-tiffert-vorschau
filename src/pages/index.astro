---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Stimme from '../components/Stimme.astro';
import { u } from '../lib/site';
import { STIMMEN } from '../lib/stimmen';

---
<Base
  title="Startseite"
  description="Dr. Alexander Tiffert, Lübeck: Entscheidungsbegleitung für Unternehmer, Geschäftsführer und Führungskräfte, Nachfolgebegleitung für Familienunternehmen und Supervision für Beratungsteams."
>
  <!-- HERO: freigegebener Einstieg, wortgetreu -->
  <section class="hero dark" aria-labelledby="claim">
    <div class="hero-media" aria-hidden="true">
      <Photo name="site-terrasse" w={3543} h={1730} alt="" sizes="100vw" position="70% 30%" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="claim">Komplexität klären. <span>Verantwortlich entscheiden.</span></h1>
      <p class="lead">Ich begleite Führungskräfte und Managementteams in schwierigen Entscheidungssituationen.</p>
      <div class="hero-cta">
        <a class="btn btn--gold" href={u('kontakt/')}>Erstgespräch anfragen <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-photo-mobile">
        <Photo name="site-terrasse-mobil" w={2306} h={1730} alt="Dr. Alexander Tiffert steht an einer geöffneten Glastür einer Dachterrasse und blickt über die Stadt." sizes="100vw" eager />
      </figure>
    </div>
  </section>

  <!-- THEMENFELDER -->
  <section class="section paper" aria-labelledby="h-felder">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Themenfelder</p>
        <h2 id="h-felder">Wobei ich begleite</h2>
      </div>
      <ol class="occasions four">
        {[
          ['I', 'Executive Coaching', 'Für Führungskräfte, die eine Entscheidung allein verantworten.', 'executive-coaching/'],
          ['II', 'Managementteams', 'Für Teams, die gemeinsam entscheiden müssen.', 'executive-coaching/'],
          ['III', 'Nachfolge', 'Für Familienunternehmen im Übergang.', 'nachfolge/'],
          ['IV', 'Supervision', 'Für interne und externe Beratungsteams.', 'supervision/'],
        ].map(([n, t, x, h], i) => (
          <li class={`reveal reveal-d${i % 3}`}>
            <a href={u(h)}>
              <span class="roman" aria-hidden="true">{n}</span>
              <h3>{t}</h3>
              <p>{x}</p>
              <span class="more">Mehr <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HINTERGRUND -->
  <section class="section" aria-labelledby="h-hintergrund">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">02</span> Hintergrund</p>
        <h2 id="h-hintergrund">Was mich qualifiziert</h2>
      </div>
      <ul class="proof reveal">
        <li><strong>20</strong> Jahre Beratung in Organisations- und Führungsfragen</li>
        <li><strong>Dr.</strong> Diplom-Wirtschaftsingenieur, Promotion an der Universität Rostock</li>
        <li><strong>10</strong> Jahre Lehre an Hochschulen und drei Fachbücher</li>
      </ul>
      <a class="more" href={u('profil/')}>Zum Profil <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <Stimme {...STIMMEN.meyer} />

  <!-- FOTOGRAFIE -->
  <section class="section art dark" aria-labelledby="h-foto">
    <div class="wrap art-grid">
      <figure class="art-img reveal">
        <Photo name="7Y5A0358" w={5359} h={3573} alt="Straßenfotografie von Alexander Tiffert." sizes="(min-width: 1024px) 58vw, 100vw" />
      </figure>
      <div class="art-text reveal reveal-d1">
        <p class="eyebrow">Künstlerische Fotografie</p>
        <h2 id="h-foto">Genau hinsehen</h2>
        <a class="more" href={u('fotografie/')}>Zur Fotografie <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-media { display: none; }
  .hero-inner { position: relative; padding-block: var(--s4) var(--s4); }
  .hero h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.6rem); margin-bottom: var(--s3); }
  .hero h1 span { display: block; }
  .hero .lead { color: #fff; max-width: 36ch; margin-bottom: var(--s3); }
  .hero-cta { margin-bottom: var(--s3); }
  .hero-p1 { color: #d6ded9; max-width: 58ch; margin: 0; }
  .hero-photo-mobile { margin: 0 calc(-1 * var(--gutter)) var(--s3); }
  .hero-photo-mobile :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 420px) { .hero-cta .btn { width: 100%; } }

  @media (min-width: 1024px) {
    .hero-media { display: block; position: absolute; inset: 0; }
    .hero-media :global(picture) { display: block; height: 100%; }
    .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .hero-media::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(21, 38, 31, 0.97) 0%, rgba(31, 56, 50, 0.92) 36%, rgba(31, 56, 50, 0.55) 54%, rgba(31, 56, 50, 0) 70%);
    }
    .hero-photo-mobile { display: none; }
    .hero-inner { display: flex; flex-direction: column; align-items: flex-start; padding-block: clamp(3.5rem, 6vw, 5rem); min-height: min(68vh, 620px); justify-content: center; }
    .hero h1, .hero .lead, .hero-p1 { max-width: 640px; }
    .hero .lead { max-width: 520px; }
    .hero-p1 { order: 1; margin-bottom: var(--s3); }
    .hero-cta { order: 2; margin: var(--s1) 0 0; }
  }

  /* Anlässe */
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .occasions a { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 2.6vw, 2.25rem); background: var(--white); text-decoration: none; color: var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease); }
  .occasions .roman { font-family: var(--display); font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3.2rem); line-height: 1; color: var(--gold-ink); margin-bottom: var(--s2); transition: color 0.35s; }
  .occasions h3 { font-family: var(--display); font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.95rem); font-weight: 600; line-height: 1.12; }
  .occasions p { flex: 1; color: var(--ink-2); transition: color 0.35s; }
  .occasions a:hover, .occasions a:focus-visible { background: var(--navy); color: var(--white); }
  .occasions a:hover h3, .occasions a:focus-visible h3 { color: var(--white); }
  .occasions a:hover .roman, .occasions a:focus-visible .roman, .occasions a:hover .more, .occasions a:focus-visible .more { color: var(--gold); }
  .occasions a:hover p, .occasions a:focus-visible p { color: #d6ded9; }
  .occasions a:hover .more .arrow { transform: translateX(5px); }
  @media (min-width: 900px) { .occasions { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .hero-kicker { color: var(--gold); margin-bottom: var(--s2); }

  /* Belege */
  .proof { list-style: none; margin: 0 0 var(--s3); padding: 0; display: grid; gap: var(--s3); }
  .proof li { color: var(--ink-2); max-width: 30ch; }
  .proof strong { display: block; font-family: var(--display); font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); font-weight: 500; line-height: 1; color: var(--navy); margin-bottom: 0.4rem; }
  @media (min-width: 900px) { .proof { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s4); } }
  @media (min-width: 900px) { .occasions.four { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 600px) and (max-width: 899px) { .occasions.four { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Fotografie */
  .art-grid { display: grid; gap: var(--s4); align-items: center; }
  .art-img { margin: 0; }
  .art-img :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .art-text p:not(.eyebrow) { color: #d6ded9; max-width: 46ch; }
  .art-text .more { color: #fff; }
  @media (min-width: 1024px) { .art-grid { grid-template-columns: 7fr 5fr; gap: clamp(3rem, 5vw, 5rem); } }

</style>
