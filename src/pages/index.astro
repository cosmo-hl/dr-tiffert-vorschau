---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/site';

const FELDER = [
  { titel: 'Organisationsentwicklung', text: 'Heute liegt mein Schwerpunkt auf der Begleitung von Familienunternehmen in Nachfolgesituationen.', link: 'Zur Organisationsentwicklung', href: 'organisationsentwicklung/' },
  { titel: 'Executive Coaching', text: 'Entscheidungen, die Sie nicht delegieren können.', link: 'Zum Executive Coaching', href: 'organisationsentwicklung/#executive-coaching' },
  { titel: 'Supervision', text: 'Wenn sich Schwierigkeiten aus dem Kundensystem im Beratungsteam wiederholen, lohnt es sich, genauer hinzusehen. Ich unterstütze Teams bei der Reflexion laufender Mandate.', link: 'Zur Supervision', href: 'supervision/' },
  { titel: 'Künstlerische Fotografie', text: 'In meiner Straßenfotografie suche ich nach Momenten, in denen vertraute Situationen ihre Eindeutigkeit verlieren.', link: 'Zur künstlerischen Fotografie', href: 'fotografie/' },
  { titel: 'Lehre', text: 'Ich unterrichte Organisationsberatung und künstlerische Fotografie.', link: 'Zur Lehre', href: 'lehre/' },
  { titel: 'Publikationen', text: 'Fragen aus beiden Feldern vertiefe ich in meinen Texten.', link: 'Zu den Publikationen', href: 'publikationen/' },
];
---
<Base
  title="Startseite"
  description="Dr. Alexander Tiffert begleitet Führungskräfte, Managementteams, Unternehmerfamilien und Beratungsteams, wenn keine Option einfach ist: Organisationsentwicklung in der Nachfolge, Executive Coaching und Supervision."
>
  <!-- HERO: freigegebener Einstieg, wortgetreu -->
  <section class="hero dark" aria-labelledby="claim">
    <div class="hero-media" aria-hidden="true">
      <Photo name="site-terrasse" w={3543} h={1730} alt="" sizes="100vw" position="70% 30%" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="claim">Komplexität klären. <span>Verantwortlich entscheiden.</span></h1>
      <p class="lead">Ich begleite Menschen und Teams in Verantwortung, wenn keine Option einfach ist und mehrere Systeme zugleich unter Druck geraten.</p>
      <div class="hero-cta">
        <a class="btn btn--gold" href={u('kontakt/')}>Persönliches Gespräch anfragen <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-photo-mobile">
        <Photo name="site-terrasse-mobil" w={2306} h={1730} alt="Dr. Alexander Tiffert steht an einer geöffneten Glastür einer Dachterrasse und blickt über die Stadt." sizes="100vw" eager />
      </figure>
      <p class="hero-p1">Ich helfe Führungskräften und Managementteams in Verantwortung auch in schwierigen Situationen und unter hoher Unsicherheit entscheidungsfähig zu sein. Das ist besonders relevant, wenn keine Option wirklich gut ist und einfache Lösungen nicht erkennbar sind.</p>
    </div>
  </section>

  <!-- EINSTIEG: neuer Absatz direkt nach dem freigegebenen Einstieg -->
  <section class="section intro" aria-labelledby="h-einstieg">
    <div class="wrap intro-grid">
      <h2 id="h-einstieg" class="visually-hidden">Schwerpunkt und Erfahrung</h2>
      <p class="intro-main reveal">Seit fast 20 Jahren begleite ich komplexe Organisationsentwicklungsprojekte, auch im internationalen Kontext. Heute liegt mein Schwerpunkt auf der Begleitung von Familienunternehmen in Nachfolgesituationen. Gleichzeitig bringe ich meine Erfahrung aus diesen Projekten in die Supervision von Organisationsberatungen und ihren Teams ein. Gemeinsam reflektieren wir die Dynamiken im Kundenunternehmen und im Beratungsteam, damit die Beratenden den Prozess klarer einschätzen und ihre nächsten Schritte bewusst gestalten können. Allen diesen Situationen ist eine Frage gemeinsam: Wie gehen wir mit Unsicherheit um und wie bleiben wir entscheidungsfähig?</p>
      <div class="intro-side reveal reveal-d1">
        <p>In der Organisationsentwicklung und in meiner künstlerischen Fotografie beschäftigt mich dieselbe Frage: Was geschieht zwischen Menschen?</p>
        <p>Meine Praxiserfahrung vertiefe ich durch Forschung und gebe sie in Lehrveranstaltungen und eigenen Publikationen weiter.</p>
      </div>
    </div>
  </section>

  <!-- GESPRÄCHSANLÄSSE -->
  <section class="section paper" id="anlaesse" aria-labelledby="h-anlaesse">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">01</span> Anlässe</p>
        <h2 id="h-anlaesse">Wann ein Gespräch sinnvoll ist</h2>
      </div>
      <ol class="occasions">
        <li class="reveal">
          <a href={u('organisationsentwicklung/#executive-coaching')}>
            <span class="roman" aria-hidden="true">I</span>
            <h3>Führen unter hoher Unsicherheit.</h3>
            <p>Wichtige Kunden fallen weg, der Markt ist schwer einzuschätzen, und Ihr Team braucht Orientierung.</p>
            <span class="more">Zum Executive Coaching <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d1">
          <a href={u('organisationsentwicklung/#nachfolge')}>
            <span class="roman" aria-hidden="true">II</span>
            <h3>Nachfolge mit unklaren Zuständigkeiten.</h3>
            <p>Zwei Geschwister übernehmen gemeinsam die Führung. Wer entscheidet künftig was?</p>
            <span class="more">Zur Nachfolgebegleitung <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
        <li class="reveal reveal-d2">
          <a href={u('supervision/')}>
            <span class="roman" aria-hidden="true">III</span>
            <h3>Ein Beratungsmandat ist festgefahren.</h3>
            <p>Was beim Kunden nicht geklärt ist, beschäftigt inzwischen auch Ihr Team.</p>
            <span class="more">Zur Supervision <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- SECHS FELDER -->
  <section class="section" aria-labelledby="h-felder">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="num">02</span> Arbeitsfelder</p>
        <h2 id="h-felder">Zugänge zu meiner Arbeit</h2>
      </div>
      <ul class="fields">
        {FELDER.map((f, i) => (
          <li class={`field field--${i + 1} reveal reveal-d${i % 3}`}>
            <a href={u(f.href)}>
              <span class="field-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.titel}</h3>
              <p>{f.text}</p>
              <span class="more">{f.link} <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Fragment slot="invite">
    <p class="invite-copy">Vor welcher Entscheidung stehen Sie gerade? Wenn Sie sich ein unabhängiges Gegenüber wünschen, lade ich Sie zu einem persönlichen Gespräch ein.</p>
    <p class="signature">Ihr Dr. Alexander Tiffert</p>
  </Fragment>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero-media { display: none; }
  .hero-inner { position: relative; padding-block: var(--s4) var(--s4); }
  .hero h1 { font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.6rem); margin-bottom: var(--s3); }
  .hero h1 span { display: block; }
  .hero .lead { color: #fff; max-width: 36ch; margin-bottom: var(--s3); }
  .hero-cta { margin-bottom: var(--s3); }
  .hero-p1 { color: #d6ded9; max-width: 58ch; margin: 0; }
  .hero-photo-mobile { margin: 0 calc(-1 * var(--gutter)) var(--s3); }
  .hero-photo-mobile :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 420px) { .hero-cta .btn { width: 100%; } }

  @media (min-width: 1024px) {
    .hero-media { display: block; position: absolute; inset: 0; }
    .hero-media :global(picture) { display: block; height: 100%; }
    .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .hero-media::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, rgba(21, 38, 31, 0.97) 0%, rgba(31, 56, 50, 0.92) 36%, rgba(31, 56, 50, 0.55) 54%, rgba(31, 56, 50, 0) 70%);
    }
    .hero-photo-mobile { display: none; }
    .hero-inner { display: flex; flex-direction: column; align-items: flex-start; padding-block: clamp(3.5rem, 6vw, 5rem); min-height: min(68vh, 620px); justify-content: center; }
    .hero h1, .hero .lead, .hero-p1 { max-width: 640px; }
    .hero .lead { max-width: 520px; }
    .hero-p1 { order: 1; margin-bottom: var(--s3); }
    .hero-cta { order: 2; margin: var(--s1) 0 0; }
  }

  /* Einstieg */
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3) var(--s4); }
  .intro-main { font-size: clamp(1.15rem, 1.05rem + 0.45vw, 1.35rem); line-height: 1.6; margin: 0; color: var(--ink); }
  .intro-side { border-top: 2px solid var(--gold-ink); padding-top: var(--s2); color: var(--ink-2); }
  .intro-side p:last-child { margin: 0; }
  @media (min-width: 1024px) {
    .intro-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  }

  /* Anlässe */
  .occasions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; background: var(--rule); border: 1px solid var(--rule); }
  .occasions a { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 2.6vw, 2.25rem); background: var(--white); text-decoration: none; color: var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease); }
  .occasions .roman { font-family: var(--display); font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3.2rem); line-height: 1; color: var(--gold-ink); margin-bottom: var(--s2); transition: color 0.35s; }
  .occasions h3 { font-family: var(--display); font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.95rem); font-weight: 600; line-height: 1.12; }
  .occasions p { flex: 1; color: var(--ink-2); transition: color 0.35s; }
  .occasions a:hover, .occasions a:focus-visible { background: var(--navy); color: var(--white); }
  .occasions a:hover h3, .occasions a:focus-visible h3 { color: var(--white); }
  .occasions a:hover .roman, .occasions a:focus-visible .roman, .occasions a:hover .more, .occasions a:focus-visible .more { color: var(--gold); }
  .occasions a:hover p, .occasions a:focus-visible p { color: #d6ded9; }
  .occasions a:hover .more .arrow { transform: translateX(5px); }
  @media (min-width: 900px) { .occasions { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Sechs Felder: zwei Dreiergruppen */
  .fields { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .field a {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: clamp(1.5rem, 2.6vw, 2.1rem); color: #fff; text-decoration: none; overflow: hidden;
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .field--1 a { background: linear-gradient(150deg, #2b4b43 0%, #1f3832 100%); }
  .field--2 a { background: linear-gradient(150deg, #37605a 0%, #24423b 100%); }
  .field--3 a { background: linear-gradient(150deg, #2f524a 0%, #1a302a 100%); }
  .field--4 a { background: linear-gradient(150deg, #353d3a 0%, #15261f 100%); }
  .field--5 a { background: linear-gradient(150deg, #2b4b43 0%, #1f3832 100%); }
  .field--6 a { background: linear-gradient(150deg, #37605a 0%, #24423b 100%); }
  .field a::after { content: ''; position: absolute; left: 0; bottom: 0; height: 4px; width: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease); }
  .field a:hover, .field a:focus-visible { transform: translateY(-5px); box-shadow: 0 22px 44px -24px rgba(21, 38, 31, 0.6); }
  .field a:hover::after, .field a:focus-visible::after { transform: scaleX(1); }
  .field-num { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; color: var(--gold); margin-bottom: var(--s3); }
  .field h3 { font-family: var(--display); font-size: clamp(1.6rem, 1.3rem + 0.9vw, 1.95rem); font-weight: 500; line-height: 1.08; color: #fff; }
  .field p { flex: 1; color: #d6ded9; font-size: 0.98em; }
  .field .more { color: #fff; }
  .field a:hover .more .arrow { transform: translateX(5px); }
  @media (min-width: 900px) { .fields { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
