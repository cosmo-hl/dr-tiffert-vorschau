---
// Seitenkopf der Unterseiten wie auf der Startseite: Überschrift und ein Satz auf Dunkelgrün,
// das Foto läuft rechts aus dem Grün heraus (ab 1200 px). Darunter gestapelt, Foto randlos.
import Photo from './Photo.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  name: string; w: number; h: number; alt: string;
  pos?: string;  // Bildausschnitt breit
  posM?: string; // Bildausschnitt schmal
  shift?: string; // ab 1024 px: Foto beginnt erst hier (für Motive, die links im Bild stehen)
}
const { eyebrow, title, lead, name, w, h, alt, pos = '50% 50%', posM = '50% 50%', shift } = Astro.props;
---
<header class={shift ? 'sub-hero sub-hero--shift dark' : 'sub-hero dark'} style={`--pos:${pos};--pos-m:${posM}${shift ? `;--shift:${shift}` : ''}`}>
  <div class="sub-hero-media">
    <Photo name={name} w={w} h={h} alt={alt} eager sizes="100vw" />
  </div>
  <div class="wrap sub-hero-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
